{
  "name": "极简灰",
  "name_en": "minimal_gray",
  "description": "极简灰主题：深灰主色 + 浅灰背景 + 大量留白，适合个人简历/自我介绍/述职报告等简洁场景",
  "color": {
    "primary": "#374151",
    "primary_dark": "#1F2937",
    "primary_light": "#6B7280",
    "secondary": "#9CA3AF",
    "accent": "#10B981",
    "text_primary": "#1F2937",
    "text_secondary": "#6B7280",
    "text_on_primary": "#FFFFFF",
    "text_on_dark": "#F9FAFB",
    "bg_page": "#FAFAFA",
    "bg_section": "#F3F4F6",
    "card_bg": "#FFFFFF",
    "card_border": "#E5E7EB",
    "divider": "#D1D5DB",
    "number_bg": "#374151",
    "number_fg": "#FFFFFF",
    "kpi_bg": "#FFFFFF",
    "kpi_border": "#E5E7EB",
    "kpi_number": "#374151",
    "cover_bg": "#F3F4F6",
    "cover_title": "#1F2937",
    "cover_subtitle": "#6B7280",
    "divider_bg": "#FAFAFA",
    "divider_number": "#374151",
    "divider_title": "#1F2937"
  },
  "font": {
    "family": "Microsoft YaHei",
    "family_en": "Calibri",
    "title": {"size_pt": 36, "bold": true, "color": "text_primary"},
    "subtitle": {"size_pt": 20, "bold": false, "color": "text_secondary"},
    "body": {"size_pt": 16, "bold": false, "color": "text_primary"},
    "desc": {"size_pt": 14, "bold": false, "color": "text_secondary"},
    "number": {"size_pt": 28, "bold": true, "color": "number_fg"},
    "year": {"size_pt": 24, "bold": true, "color": "primary"},
    "kpi_number": {"size_pt": 48, "bold": true, "color": "kpi_number"},
    "kpi_label": {"size_pt": 14, "bold": false, "color": "text_secondary"},
    "cover_title": {"size_pt": 44, "bold": true, "color": "cover_title"},
    "cover_subtitle": {"size_pt": 22, "bold": false, "color": "cover_subtitle"},
    "divider_number": {"size_pt": 72, "bold": true, "color": "divider_number"},
    "divider_title": {"size_pt": 40, "bold": true, "color": "divider_title"}
  },
  "spacing": {
    "safe_margin_inch": 0.6,
    "grid_gutter_inch": 0.3,
    "card_padding_inch": 0.25,
    "section_gap_inch": 0.5,
    "element_gap_inch": 0.18
  },
  "effect": {
    "card_shadow": false,
    "card_radius": true,
    "card_radius_inch": 0.06
  },
  "layout": {
    "cover_split_ratio": 0.5,
    "divider_number_ratio": 0.3,
    "kpi_card_per_row": 4,
    "numbered_list_card_per_row": 2
  }
}
